NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://abo:abo@127.0.0.1:55432/abo?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REAUTH_SECRET="change-me-reauth"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_REAUTH_TTL="5m"

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_SECONDS=30

# TEMPORARY, pre-launch only — bypasses real OTP verification for ANY phone
# number when true. Must stay false here; only ever set true in a throwaway
# testing environment with no real user data. See otp.service.ts.
OTP_BYPASS_ENABLED=false
OTP_BYPASS_CODE=000000

CIRCLE_INVITE_TTL_DAYS=7
LOCATION_RETENTION_DEFAULT_DAYS=7
LOCATION_RETENTION_MAX_DAYS=30

COMMUNITY_HAZARD_TTL_HOURS=24
COMMUNITY_ALERT_TTL_DAYS=7

SMS_PROVIDER="termii"
TERMII_API_KEY=""
TERMII_SENDER_ID="Abo"

FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY_PATH=""
APNS_PRODUCTION="false"

FIELD_ENCRYPTION_KEY="change-me-32-byte-key-please-fix"
